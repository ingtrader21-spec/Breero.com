APP_ENV=development
APP_NAME=BREERO API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://breero:breero@postgres:5432/breero
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
GEOCODING_API_KEY=
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=
PAYOUT_PROVIDER=
PAYOUT_API_KEY=
CORS_ORIGINS=http://localhost:3000

# Metrics, traces, and structured logs. The OTLP endpoint must be private or mTLS protected.
METRICS_ENABLED=true
METRICS_PATH=/metrics
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=breero-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS_FILE=
OTEL_EXPORTER_TIMEOUT_SECONDS=5
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXCLUDED_URLS=health,metrics
RUNTIME_HEARTBEAT_KEY=breero:runtime:heartbeat
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Browser-safe frontend configuration. Never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_TIMEOUT_MS=12000
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Server-only URL used by the Next.js form proxy. Prefer the private API service address in deployment.
BREERO_API_INTERNAL_URL=http://api:8000/api/v1

# Separate release gate; production activation is not certified.
LIVE_EMAIL_DELIVERY=false
