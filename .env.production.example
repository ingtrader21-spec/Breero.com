# Loaded into api/migrate/worker/scheduler AND postgres via the single
# BREERO_ENV_FILE referenced by docker-compose.production.yml. Secret values
# (database/redis URLs, JWT secrets, the Postgres password, the Geoapify key)
# are NOT set here -- they're mounted as files by Docker secrets, and this
# file only points each app setting at its in-container mount path
# (/run/secrets/<name>, provided automatically once a service declares that
# secret). The actual secret file locations on the host are set via the
# *_REFERENCE variables docker-compose.production.yml itself reads
# (DATABASE_URL_REFERENCE, JWT_SECRET_REFERENCE, POSTGRES_PASSWORD_REFERENCE,
# REDIS_ACL_FILE_REFERENCE, etc.) -- those belong in the shell/CI environment
# that runs `docker compose up`, never in this file.

APP_ENV=production
DATABASE_URL_FILE=/run/secrets/breero_database_url
REDIS_URL_FILE=/run/secrets/breero_redis_url
JWT_SECRET_FILE=/run/secrets/breero_jwt_access_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/breero_jwt_refresh_secret

# Only read inside the postgres container; harmless elsewhere.
POSTGRES_DB=breero_prod
POSTGRES_USER=breero_prod
POSTGRES_PASSWORD_FILE=/run/secrets/breero_postgres_password

CORS_ORIGINS=https://breero.com,https://www.breero.com

KEYCLOAK_ENABLED=true
KEYCLOAK_ISSUER=https://auth.codestra.co/realms/codestra
KEYCLOAK_AUDIENCE=breero-api-production

# Release-gated marketplace capability flags -- config.py's validate_production()
# rejects enabling most of these in production until the corresponding domain
# is certified. Leave false unless a specific capability has been accepted.
STRIPE_ENABLED=false
PAYMENTS_ENABLED=false
ONLINE_CHECKOUT_ENABLED=false
PAID_LEADS_ENABLED=false
AUTOMATIC_REFUNDS_ENABLED=false
AUTOMATIC_BOOKING_ENABLED=false
AUTOMATIC_CONFIRMED_BOOKINGS=false
PAYOUT_ENABLED=false

GEOCODING_ENABLED=false
GEOCODING_API_KEY_FILE=/run/secrets/breero_geoapify_api_key

EMAIL_ENABLED=false
# Separate release gate; production activation is not certified.
LIVE_EMAIL_DELIVERY=false
SMS_ENABLED=false
ODOO_ENABLED=false

# Opt-in overlay -- apply docker-compose.middleware.yml on top of
# docker-compose.production.yml only after private-route, CA, mTLS and HMAC
# enrollment has passed (see docker-compose.middleware.yml).
MIDDLEWARE_ENABLED=false
MIDDLEWARE_URL=https://middleware.internal.codestra.agency
MIDDLEWARE_CA_FILE=/run/secrets/codestra_private_ca.pem
MIDDLEWARE_CLIENT_CERT_FILE=/run/secrets/breero_middleware_client.pem
MIDDLEWARE_CLIENT_KEY_FILE=/run/secrets/breero_middleware_client.key
MIDDLEWARE_HMAC_KEY_ID=CHANGE_ME
MIDDLEWARE_HMAC_SECRET_FILE=/run/secrets/breero_middleware_hmac
MIDDLEWARE_SERVICE_IDENTITY=breero-production
MIDDLEWARE_AUDIENCE=codestra-middleware-breero
MIDDLEWARE_TENANT=breero
MIDDLEWARE_SCOPE=breero.crm.events.submit
