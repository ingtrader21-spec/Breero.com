# Non-secret interpolation fixtures used only by `docker compose config` in CI.
# Runtime deployments must supply their own approved environment and secret paths.
BREERO_IMAGE=ghcr.io/example/breero-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BREERO_ENV_FILE=.env.production.example
CADDY_NETWORK=codestra-caddy-shared
DATABASE_URL_REFERENCE=/tmp/breero-database-url
REDIS_URL_REFERENCE=/tmp/breero-redis-url
JWT_SECRET_REFERENCE=/tmp/breero-jwt-access
JWT_REFRESH_SECRET_REFERENCE=/tmp/breero-jwt-refresh
GEOAPIFY_API_KEY_REFERENCE=/tmp/breero-geoapify
POSTGRES_PASSWORD_REFERENCE=/tmp/breero-postgres-password
REDIS_ACL_FILE_REFERENCE=/tmp/breero-redis-password
BREERO_PROD_MIDDLEWARE_CA_FILE=/tmp/breero-middleware-ca
BREERO_PROD_MIDDLEWARE_HMAC_FILE=/tmp/breero-middleware-hmac
BREERO_PROD_MIDDLEWARE_CLIENT_CERT_FILE=/tmp/breero-middleware-client-cert
BREERO_PROD_MIDDLEWARE_CLIENT_KEY_FILE=/tmp/breero-middleware-client-key
BREERO_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
BREERO_OTLP_HEADERS_FILE_REFERENCE=/tmp/breero-otlp-headers
