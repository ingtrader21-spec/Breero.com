# Copy to a root-owned deployment location. Never commit populated values.
# Every image must use a registry digest, not a mutable tag.
BREERO_RELEASE_SHA=0000000000000000000000000000000000000000
BREERO_WEB_IMAGE=ghcr.io/appolon1908-hue/breero-web@sha256:REPLACE_WITH_64_HEX
BREERO_PARTNER_IMAGE=ghcr.io/appolon1908-hue/breero-partner@sha256:REPLACE_WITH_64_HEX
BREERO_OPS_IMAGE=ghcr.io/appolon1908-hue/breero-ops@sha256:REPLACE_WITH_64_HEX
BREERO_ADMIN_IMAGE=ghcr.io/appolon1908-hue/breero-admin@sha256:REPLACE_WITH_64_HEX

BREERO_WEB_PUBLIC_ORIGIN=https://breero.com
BREERO_PARTNER_PUBLIC_ORIGIN=https://partners.breero.com
BREERO_OPS_PUBLIC_ORIGIN=https://ops.breero.com
BREERO_ADMIN_PUBLIC_ORIGIN=https://admin.breero.com

# Private Kong route. It must not resolve to the public Internet and must end in /api/v1.
BREERO_API_INTERNAL_URL=http://kong:8000/breero/api/v1
BREERO_KEYCLOAK_ISSUER=https://auth.codestra.co/realms/breero
BREERO_PARTNER_KEYCLOAK_CLIENT_ID=breero-partner
BREERO_OPS_KEYCLOAK_CLIENT_ID=breero-operations
BREERO_ADMIN_KEYCLOAK_CLIENT_ID=breero-administration

BREERO_EDGE_NETWORK=codestra-edge
BREERO_GATEWAY_NETWORK=codestra-gateway

# OpenBao or the approved secret renderer writes these root-owned files before Compose runs.
# Files must be mode 0400 or 0440 and contain only the secret value.
BREERO_PARTNER_KEYCLOAK_CLIENT_SECRET_FILE=/run/codestra/secrets/breero/partner-keycloak-client-secret
BREERO_PARTNER_SESSION_SECRET_FILE=/run/codestra/secrets/breero/partner-session-secret
BREERO_OPS_KEYCLOAK_CLIENT_SECRET_FILE=/run/codestra/secrets/breero/ops-keycloak-client-secret
BREERO_OPS_SESSION_SECRET_FILE=/run/codestra/secrets/breero/ops-session-secret
BREERO_ADMIN_KEYCLOAK_CLIENT_SECRET_FILE=/run/codestra/secrets/breero/admin-keycloak-client-secret
BREERO_ADMIN_SESSION_SECRET_FILE=/run/codestra/secrets/breero/admin-session-secret

# These business capabilities remain controlled by the API deployment, not the portals.
# The production-readiness gate requires them false until separately approved.
ONLINE_PAYMENTS_ENABLED=false
PAYOUT_ENABLED=false
AUTO_ASSIGNMENT_ENABLED=false
MIDDLEWARE_ENABLED=false
TRANSACTIONAL_EMAIL_MODE=disabled
TRANSACTIONAL_SMS_MODE=disabled
