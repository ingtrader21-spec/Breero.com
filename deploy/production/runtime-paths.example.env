# BREERO production runtime-path evidence template.
#
# This file is not deployment authorization. Keep LIVE_MUTATION_ALLOWED=false.
# Replace UNVERIFIED values only from a dated, read-only host inventory. Do not
# commit production secrets, passwords, tokens, certificates, or private keys.

VERIFICATION_STATE=UNVERIFIED
LIVE_MUTATION_ALLOWED=false

EXPECTED_HOSTNAME=UNVERIFIED
EXPECTED_REPOSITORY_SHA=UNVERIFIED
REPOSITORY_ROOT=/srv/breero/repository
BACKEND_COMPOSE_PATH=/srv/breero/repository/docker-compose.production.yml
FRONTEND_COMPOSE_PATH=/srv/breero/repository/deploy/frontend/docker-compose.frontend.yml
LEGACY_BACKEND_COMPOSE_PATH=/srv/breero/repository/deploy/production/docker-compose.backend.yml
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
BACKEND_ENV_PATH=/etc/breero/production/backend.env
FRONTEND_ENV_PATH=/etc/breero/production/frontend.env

EXPECTED_BACKEND_COMPOSE_SHA256=UNVERIFIED
EXPECTED_FRONTEND_COMPOSE_SHA256=UNVERIFIED
EXPECTED_CADDY_CONFIG_SHA256=UNVERIFIED
EXPECTED_API_IMAGE=UNVERIFIED
EXPECTED_FRONTEND_IMAGE=UNVERIFIED

EXPECTED_PRIVATE_NETWORK=UNVERIFIED
EXPECTED_BACKEND_EDGE_NETWORK=UNVERIFIED
EXPECTED_FRONTEND_EDGE_NETWORK=UNVERIFIED

EXPECTED_WEB_HOST=breero.com
EXPECTED_API_HOST=api.breero.com
EXPECTED_WEB_UPSTREAM=UNVERIFIED
EXPECTED_API_UPSTREAM=UNVERIFIED
