      "id": "breero-web",
      "root": "apps/web",
      "surface": "customer",
      "theme": "breero",
      "canonicalOrigin": "https://breero.com",
      "domains": {
        "public": ["https://breero.com"],
        "partner": ["https://partners.breero.com"],
        "operator": ["https://ops.breero.com"],
        "administration": ["https://admin.breero.com"],
        "identity": ["https://auth.codestra.co"],
        "corporate": ["https://codestra.co"]
      },
      "shell": {
        "mode": "application",
        "rootFile": "apps/web/app/layout.tsx",
        "headerFile": "apps/web/components/site-header.tsx",
        "footerFile": "apps/web/components/site-footer.tsx",
        "tokensFile": "apps/web/app/horizon.css",
        "requiredRootMarkers": [
          "data-horizon-root",
          "data-horizon-theme=\"breero\"",
          "data-horizon-appearance=\"dark\""
        ],
        "pageRoots": ["apps/web/app"]
      },
      "auth": {
        "mode": "api-session",
        "protectedRoutes": true,
        "loginPath": "/account/login",
        "loginSourceFile": "apps/web/components/account/auth-form.tsx",
        "logoutSourceFile": "apps/web/lib/customer/session-actions.ts",
        "guardSourceFile": "apps/web/components/account/account-frame.tsx",
        "backendAuthorizationRequired": true,
        "headerReflectsSession": true,
        "durableIdentity": "backend-user-id",
        "migrationTarget": "issuer+subject",
        "browserTokenStorage": "legacy-session-storage-migration-required"
      },
      "colorPolicy": {
        "rejectNewRawColors": true,
        "allowedColorFiles": ["apps/web/app/horizon.css"]
      },
      "newPagePolicy": {
        "inheritsRootShell": true,
        "usesHorizonTokens": true,
        "requiresStateMatrix": true
      }
    },
