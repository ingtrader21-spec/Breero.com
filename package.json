{
  "name": "breero",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "contract:generate": "openapi-typescript apps/api/openapi.json -o packages/types/src/openapi.generated.ts",
    "contract:check:policy": "node scripts/check-frontend-openapi.mjs",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- packages/types/src/openapi.generated.ts && pnpm contract:check:policy"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "openapi-typescript": "7.13.0",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "vite": "6.4.3",
      "next": "15.5.24",
      "sharp": "0.35.4",
      "js-yaml": "4.3.2",
      "postcss": "8.5.26"
    }
  }
}
